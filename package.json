{
  "name": "houdinimd",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev -- --",
    "app:build": "dotenv -e .env.local -- tauri build",
    "portable": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$exe='src-tauri/target/release/houdinimd.exe'; if (!(Test-Path $exe)) { Write-Error 'build first: bun run app:build'; exit 1 }; New-Item -ItemType Directory -Force dist-portable | Out-Null; Copy-Item $exe dist-portable -Force; if (!(Test-Path 'dist-portable/.portable')) { New-Item -ItemType File 'dist-portable/.portable' | Out-Null }; Compress-Archive -Path 'dist-portable/houdinimd.exe','dist-portable/.portable' -DestinationPath 'dist-portable/HoudiniMD-portable.zip' -Force\"",
    "lint": "eslint .",
    "harness": "node harness/run.mts",
    "design": "node harness/design.mts",
    "pane": "node harness/pane.mts",
    "slowmo": "node harness/slowmo.mts",
    "icon:mac": "sh src-tauri/icons/build-mac.sh",
    "dmg": "tauri build --bundles app && sh src-tauri/dmg/build.sh src-tauri/target/release/bundle/macos/NodebookMD.app src-tauri/target/release/bundle/NodebookMD.dmg"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@jtche/progressive-blur": "github:JTCHE/progressive-blur",
    "@tauri-apps/api": "^2.12",
    "@tauri-apps/plugin-deep-link": "~2.4.10",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "highlight.js": "^11.12.0",
    "html-url-attributes": "^3.0.1",
    "lucide-react": "^1.35.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwind-merge": "^3.4.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@csstools/postcss-color-mix-function": "4.0.11",
    "@csstools/postcss-oklab-function": "5.0.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "4.1.18",
    "@tauri-apps/cli": "^2.12",
    "@types/node": "^26.4.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.0",
    "dotenv-cli": "^11.0.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.1.0"
  }
}
