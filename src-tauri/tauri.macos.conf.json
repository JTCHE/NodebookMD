{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBundleCommand": "cc -O2 -o src-tauri/macos/houdinimd src-tauri/macos/houdinimd.c"
  },
  "bundle": {
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "-",
      "files": {
        "Resources/Assets.car": "icons/Assets.car",
        "MacOS/houdinimd": "macos/houdinimd"
      }
    }
  }
}
