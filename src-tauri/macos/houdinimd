#!/bin/sh
# Before 0.3.0 the executable of this app was named houdinimd, and the
# Houdini startup script written by those versions names it. A Houdini that
# starts before the updated app does would find no file there and give F1
# back. This hands the call to the new executable, which then writes the
# script again with its own name (hook::refresh).
exec "$(dirname "$0")/nodebookmd" "$@"
